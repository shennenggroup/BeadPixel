# ── 依赖 ──
node_modules/

# ── 环境变量（含本地配置，勿提交）──
.env
.env.local
.env.*.local

# ── 运行时产物（由程序生成，勿提交）──
uploads/
exports/
data/history.json
!data/.gitkeep

# ── 本地工具 / IDE 目录 ──
.trae/
.workbuddy-ai/
.vscode/
.idea/
*.swp

# ── 操作系统 / 编辑器垃圾文件 ──
.DS_Store
Thumbs.db
nul

# ── 日志 ──
*.log
npm-debug.log*
